# Bank credentials for the open-banking-chile scraper (names follow its CLI convention).
# Copy to .env — which is gitignored — and fill in. Never commit real values.
SANTANDER_RUT=12345678-9
SANTANDER_PASS=
BANCOCHILE_RUT=12345678-9
BANCOCHILE_PASS=
BCI_RUT=12345678-9
BCI_PASS=
# Seconds to wait for the BCI Pass in-app approval (30-600, scraper default 180).
# BCI_2FA_TIMEOUT_SEC=180

# Racional.cl brokerage (Firebase email+password). RACIONAL_DEVICE_ID must be a device UUID
# Racional already trusts — capture it from an authenticated web session's authMfaStart
# request (see docs/racional-api.md); an untrusted device triggers an MFA code we can't answer.
RACIONAL_EMAIL=
RACIONAL_PASS=
RACIONAL_DEVICE_ID=

# BetterPlan.cl bootstrap refresh token. Capture it once from a browser login (the
# POST id.betterplan.cl/connect/token response — see docs/betterplan-api.md, Bootstrap).
# This seeds the FIRST run only; the adapter then rotates + persists the live token in the
# state db. To force a re-bootstrap after the chain dies, paste a fresh token here.
BETTERPLAN_REFRESH_TOKEN=

# Lunch Money API token (https://my.lunchmoney.app/developers)
LUNCHMONEY_TOKEN=
