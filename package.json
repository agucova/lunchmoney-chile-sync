    "open-banking-chile": "file:vendor/open-banking-chile-2.0.0.tgz",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4",
    "oxfmt": "latest",
    "oxlint": "^1",
    "typescript": "^5"
  }
}
