{
  "name": "lunchmoney-chile-sync",
  "private": true,
  "description": "Syncs Chilean bank accounts and credit cards into Lunch Money",
  "license": "MPL-2.0",
  "type": "module",
  "module": "src/main.ts",
  "scripts": {
    "sync": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
